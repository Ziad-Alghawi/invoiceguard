          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, purpose) (rate(invoiceguard_llm_latency_seconds_bucket[15m])))",
          "legendFormat": "{{purpose}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
