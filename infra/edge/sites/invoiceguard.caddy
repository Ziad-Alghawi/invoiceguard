# InvoiceGuard public demo, served from k3s on this server (ADR-021, ADR-024). Caddy keeps TLS and
# forwards to k3s's Traefik on Docker's bridge address (host.docker.internal, extra_hosts in
# ../compose.yml); Traefik routes the host name to the web pods. Caddy sets X-Forwarded-For to the
# visitor's address, which Traefik trusts from Caddy only (infra/k3s/traefik-config.yaml).
invoiceguard.ziadalghawi.com {
	import security_headers
	encode zstd gzip

	# Uploads are limited to 10 MiB in the api; refuse anything far larger at the edge.
	request_body {
		max_size 12MB
	}

	reverse_proxy host.docker.internal:8880
}
