# InvoiceGuard environment variables
# Copy to .env and fill in values. Never commit .env.
# Variables are added here together with the code that reads them (database, LLM keys, Langfuse, ...).

# apps/api
INVOICEGUARD_ENV=dev
INVOICEGUARD_LOG_LEVEL=INFO

# apps/web (copy into apps/web/.env.local; server-only, read per request)
# In Docker Compose the web container uses http://api:8000 instead; this value is for `pnpm dev`.
API_URL=http://localhost:8000

# db (Docker Compose, PostgreSQL 16 + pgvector). Local development values only.
POSTGRES_USER=invoiceguard
POSTGRES_PASSWORD=invoiceguard-dev
POSTGRES_DB=invoiceguard

# Host ports published by Docker Compose (bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
