# InvoiceGuard environment variables
# Copy to .env and fill in values. Never commit .env.
# Variables are added here together with the code that reads them (LLM keys, Langfuse, ... later).

# apps/api
INVOICEGUARD_ENV=dev
INVOICEGUARD_LOG_LEVEL=INFO
# Database for `uv run` outside Docker (Compose builds its own URL from the POSTGRES_* values below).
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls for seconds.
# URL-encode special characters in the password.
INVOICEGUARD_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard
# Test database: dropped and recreated by every `make test`, so its name must end in _test.
INVOICEGUARD_TEST_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard_test
# Uploaded invoice files (a volume at /data/uploads in Docker) and the upload size limit (10 MiB).
INVOICEGUARD_STORAGE_DIR=data/uploads
INVOICEGUARD_MAX_UPLOAD_BYTES=10485760
# Uploads per user per hour (429 above); empty = no limit. The demo defaults to 30 (docker-compose.prod.yml).
INVOICEGUARD_UPLOAD_MAX_PER_HOUR=
# KoSIT validator (services/validator) for `uv run` outside Docker; unset = the KoSIT check is skipped.
INVOICEGUARD_VALIDATOR_URL=http://127.0.0.1:8081/
INVOICEGUARD_VALIDATOR_TIMEOUT_SECONDS=20
# Validator for the `kosit` tests (make test); without it those tests are skipped.
INVOICEGUARD_TEST_VALIDATOR_URL=http://127.0.0.1:8081/
# Eval harness (make eval, ADR-019): the fraud and attack sets run the app on this database, which is
# dropped and recreated, so its name must end in _eval; with the validator URL, KoSIT runs too (the
# recorded agent replies were made with it, so the attack replay needs it).
INVOICEGUARD_EVAL_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard_eval
INVOICEGUARD_EVAL_VALIDATOR_URL=http://127.0.0.1:8081/
# LLM extraction of plain PDFs (ADR-004, ADR-010). Empty key: plain PDFs stay `awaiting_extraction`.
# A Gemini API key from Google AI Studio; the free tier may use inputs for training, so send only
# made-up or public sample invoices. Never commit the key.
INVOICEGUARD_LLM_API_KEY=
# LiteLLM model string; its price must be in LiteLLM's pinned price table (unknown price = error).
INVOICEGUARD_EXTRACTION_MODEL=gemini/gemini-3.8-flash
INVOICEGUARD_LLM_TIMEOUT_SECONDS=120
# How much the model may think before answering: minimal, low, medium, high. Thinking tokens are
# billed as output; `low` is the lowest level Gemini 3.8 Flash accepts (ADR-010).
INVOICEGUARD_EXTRACTION_REASONING_EFFORT=low
# Fields extracted with a lower confidence get a `low_confidence` check (IBAN and totals: blocked).
INVOICEGUARD_EXTRACTION_CONFIDENCE_THRESHOLD=0.9
# LLM spending cap per UTC day in US dollars (ADR-014); once reached, PDFs wait. Empty: no cap.
# The demo server's prod override defaults it to 0.50.
INVOICEGUARD_LLM_DAILY_BUDGET_USD=
# Exception agent (ADR-018): investigates blocked invoices with the read-only MCP servers when a
# model key is set (Compose sets the MCP URLs). Empty model: the extraction model. Limits per run;
# the cost cap counts every agent call for an invoice. Without a key, "Investigate" shows a
# recorded run for the demo samples.
INVOICEGUARD_AGENT_MODEL=
INVOICEGUARD_AGENT_REASONING_EFFORT=low
INVOICEGUARD_AGENT_MAX_STEPS=8
INVOICEGUARD_AGENT_MAX_TOOL_CALLS=12
INVOICEGUARD_AGENT_TIMEOUT_SECONDS=90
INVOICEGUARD_AGENT_COST_CAP_USD=0.05
# Investigate every invoice that processing leaves blocked (true) or only on "Investigate" (false).
INVOICEGUARD_AGENT_AUTO_INVESTIGATE=true
# Booking suggestions (ADR-020): embeddings of invoice line texts, with the same key. Its vectors
# must have 768 numbers; after a change run `make index`.
INVOICEGUARD_EMBEDDING_MODEL=gemini/gemini-embedding-001
# The rulebook (docs/rulebook) that `invoiceguard-index` indexes for the agent's search_rulebook.
# The api image sets /app/rulebook; for `uv run invoiceguard-index` in apps/api use ../../docs/rulebook.
INVOICEGUARD_RULEBOOK_DIR=
# Login sessions and lockout (ADR-011): session lifetime, failed logins in a row before a lockout,
# and how long the lockout lasts.
INVOICEGUARD_SESSION_TTL_MINUTES=480
INVOICEGUARD_LOGIN_MAX_FAILURES=5
INVOICEGUARD_LOGIN_LOCKOUT_MINUTES=15
# How long a review decision waits for a run on the same invoice before it answers 409 (R4-2).
INVOICEGUARD_DECISION_LOCK_TIMEOUT_MS=2000
# DATEV-style booking export (ADR-013). Placeholders for a demo client on SKR03: a real export needs
# the advisor and client numbers, fiscal year and accounts your tax advisor uses.
INVOICEGUARD_DATEV_ADVISOR_NUMBER=1001
INVOICEGUARD_DATEV_CLIENT_NUMBER=1
INVOICEGUARD_DATEV_FISCAL_YEAR_START_MONTH=1
INVOICEGUARD_DATEV_ACCOUNT_LENGTH=4
INVOICEGUARD_DATEV_CHART_OF_ACCOUNTS=03
# Konto (collective creditor) and Gegenkonto (expense account, not an automatic tax account).
INVOICEGUARD_DATEV_CREDITOR_ACCOUNT=70000
INVOICEGUARD_DATEV_EXPENSE_ACCOUNT=4900
# Input VAT rate -> BU key, as JSON (SKR03: 9 = 19 % Vorsteuer, 8 = 7 % Vorsteuer).
INVOICEGUARD_DATEV_TAX_KEYS={"19": "9", "7": "8"}
# The users that `make seed-user` creates or resets (there is no sign-up, ADR-006). Choose your
# own passwords (at least 12 characters, no `$` or `#`: make reads this file) and never commit them.
# Run `make seed-user` again with other values to add more users.
INVOICEGUARD_SEED_USER_EMAIL=reviewer@example.com
INVOICEGUARD_SEED_USER_PASSWORD=
INVOICEGUARD_SEED_USER_NAME=Demo Reviewer
# reviewer or approver (ADR-016).
INVOICEGUARD_SEED_USER_ROLE=reviewer
# A second user with the approver role: confirms or declines another user's override of a blocked
# invoice (four eyes, ADR-016). Empty email: no approver is seeded. The e2e tests need it.
INVOICEGUARD_SEED_APPROVER_EMAIL=approver@example.com
INVOICEGUARD_SEED_APPROVER_PASSWORD=
INVOICEGUARD_SEED_APPROVER_NAME=Demo Approver
# Passwords of the read-only database roles of the MCP servers (ADR-017). Required by Compose;
# `invoiceguard-db-roles` sets them when the api starts. Use long random values of letters and
# digits (they go into a URL), for example `python -c "import secrets; print(secrets.token_hex(24))"`.
INVOICEGUARD_MCP_ERP_DB_PASSWORD=
INVOICEGUARD_MCP_REGISTRY_DB_PASSWORD=
INVOICEGUARD_MCP_HISTORY_DB_PASSWORD=

# apps/web (copy into apps/web/.env.local; server-only, read per request)
# In Docker Compose the web container uses http://api:8000 instead; this value is for `pnpm dev`.
API_URL=http://localhost:8000

# db (Docker Compose, PostgreSQL 16 + pgvector). Local development values only.
POSTGRES_USER=invoiceguard
POSTGRES_PASSWORD=invoiceguard-dev
POSTGRES_DB=invoiceguard

# `make deploy` (docs/deploy.md): the SSH target of the demo server, user@host. Only on your own
# machine, never on the server; empty: `make deploy` refuses to run.
# Example: DEPLOY_HOST=deploy@203.0.113.10
DEPLOY_HOST=

# Host ports published by Docker Compose (bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
VALIDATOR_PORT=8081
MCP_ERP_PORT=8091
MCP_REGISTRY_PORT=8092
MCP_HISTORY_PORT=8093
