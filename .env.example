# InvoiceGuard environment variables
# Copy to .env and fill in values. Never commit .env.
# Variables are added here together with the code that reads them (LLM keys, Langfuse, ... later).

# apps/api
INVOICEGUARD_ENV=dev
INVOICEGUARD_LOG_LEVEL=INFO
# Database for `uv run` outside Docker (Compose builds its own URL from the POSTGRES_* values below).
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls for seconds.
# URL-encode special characters in the password.
INVOICEGUARD_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard
# Test database: dropped and recreated by every `make test`, so its name must end in _test.
INVOICEGUARD_TEST_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard_test
# Uploaded invoice files (a volume at /data/uploads in Docker) and the upload size limit (10 MiB).
INVOICEGUARD_STORAGE_DIR=data/uploads
INVOICEGUARD_MAX_UPLOAD_BYTES=10485760
# KoSIT validator (services/validator) for `uv run` outside Docker; unset = the KoSIT check is skipped.
INVOICEGUARD_VALIDATOR_URL=http://127.0.0.1:8081/
INVOICEGUARD_VALIDATOR_TIMEOUT_SECONDS=20
# Validator for the `kosit` tests (make test); without it those tests are skipped.
INVOICEGUARD_TEST_VALIDATOR_URL=http://127.0.0.1:8081/
# LLM extraction of plain PDFs (ADR-004, ADR-010). Empty key: plain PDFs stay `awaiting_extraction`.
# A Gemini API key from Google AI Studio; the free tier may use inputs for training, so send only
# made-up or public sample invoices. Never commit the key.
INVOICEGUARD_LLM_API_KEY=
# LiteLLM model string; its price must be in LiteLLM's pinned price table (unknown price = error).
INVOICEGUARD_EXTRACTION_MODEL=gemini/gemini-3.8-flash
INVOICEGUARD_LLM_TIMEOUT_SECONDS=120
# How much the model may think before answering: minimal, low, medium, high. Thinking tokens are
# billed as output; `low` is the lowest level Gemini 3.8 Flash accepts (ADR-010).
INVOICEGUARD_EXTRACTION_REASONING_EFFORT=low
# Fields extracted with a lower confidence get a `low_confidence` check (IBAN and totals: blocked).
INVOICEGUARD_EXTRACTION_CONFIDENCE_THRESHOLD=0.8

# apps/web (copy into apps/web/.env.local; server-only, read per request)
# In Docker Compose the web container uses http://api:8000 instead; this value is for `pnpm dev`.
API_URL=http://localhost:8000

# db (Docker Compose, PostgreSQL 16 + pgvector). Local development values only.
POSTGRES_USER=invoiceguard
POSTGRES_PASSWORD=invoiceguard-dev
POSTGRES_DB=invoiceguard

# Host ports published by Docker Compose (bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
VALIDATOR_PORT=8081
