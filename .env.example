# InvoiceGuard environment variables
# Copy to .env and fill in values. Never commit .env.
# Variables are added here together with the code that reads them (LLM keys, Langfuse, ... later).

# apps/api
INVOICEGUARD_ENV=dev
INVOICEGUARD_LOG_LEVEL=INFO
# Database for `uv run` outside Docker (Compose builds its own URL from the POSTGRES_* values below).
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and stalls for seconds.
# URL-encode special characters in the password.
INVOICEGUARD_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard
# Test database: dropped and recreated by every `make test`, so its name must end in _test.
INVOICEGUARD_TEST_DATABASE_URL=postgresql+psycopg://invoiceguard:invoiceguard-dev@127.0.0.1:5432/invoiceguard_test
# Uploaded invoice files (a volume at /data/uploads in Docker) and the upload size limit (10 MiB).
INVOICEGUARD_STORAGE_DIR=data/uploads
INVOICEGUARD_MAX_UPLOAD_BYTES=10485760

# apps/web (copy into apps/web/.env.local; server-only, read per request)
# In Docker Compose the web container uses http://api:8000 instead; this value is for `pnpm dev`.
API_URL=http://localhost:8000

# db (Docker Compose, PostgreSQL 16 + pgvector). Local development values only.
POSTGRES_USER=invoiceguard
POSTGRES_PASSWORD=invoiceguard-dev
POSTGRES_DB=invoiceguard

# Host ports published by Docker Compose (bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
